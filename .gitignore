# Whitelist: ignore everything, then allow only the project's own source files.
# Sheet music (PDFs, page pictures, MusicXML, MuseScore files), recordings and conversion output are
# usually copyrighted or personal, so they must never be committed by accident.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/convert.ps1
!/convert_homr.ps1
!/homr_run.py
!/homr_merge.py
!/homr_compare.py
!/homr_ottava.py
!/homr_dynamics.py
!/omr_tools.py
!/omr_repair.py
!/omr_ottava.py
!/omr_parts.py
!/omr_clefs.py
!/omr_keys.py
!/omr_proofread.py
!/omr_vote.py
!/omr_pageslurs.py
!/omr_ghosts.py
!/omr_locate.py
!/omr_dots.py
!/omr_fermata.py
!/omr_trill.py
!/omr_grace.py
!/omr_orphans.py
!/omr_tuplets.py
!/omr_pad.py
!/omr_dewarp.py
!/omr_runs.py
!/omr_confidence.py
!/omr_voices.py
!/piano_check.py
!/live_check.py
!/live_page.html
!/report_html.py
!/make_test_audio.py
!/tutor/
!/docs/

# the web app in docs/ (GitHub Pages): everything except local test recordings
/docs/test/*
!/docs/test/run.mjs

# inside tutor/ only the page itself
/tutor/*
!/tutor/index.html

__pycache__/
*.pyc
